{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouinpo.example/schemas/ouinpo-pack.schema.json",
  "title": "OuInPo pedagogical pack",
  "type": "object",
  "required": ["schema_version", "pack"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "1.0" },
    "pack": {
      "type": "object",
      "required": ["slug", "title"],
      "additionalProperties": true,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "license": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "school_levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "label"],
        "properties": {
          "slug": { "type": "string" },
          "label": { "type": "string" },
          "sort_order": { "type": "integer" },
          "rank": { "type": "integer" }
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "label"],
        "properties": {
          "slug": { "type": "string" },
          "label": { "type": "string" },
          "track": { "type": "string" },
          "description": { "type": "string" },
          "sort_order": { "type": "integer" },
          "active": { "type": "integer", "enum": [0, 1] }
        }
      }
    },
    "difficulties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "label"],
        "properties": {
          "slug": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "domain", "domain_slug", "competency"],
        "properties": {
          "slug": { "type": "string" },
          "track": { "type": "string" },
          "level": { "type": "string" },
          "level_slug": { "type": "string" },
          "level_slugs": { "type": "array", "items": { "type": "string" } },
          "domain": { "type": "string" },
          "domain_slug": { "type": "string" },
          "competency": { "type": "string" },
          "capacity": { "type": "string" },
          "example": { "type": "string" },
          "reference_url": { "type": "string" },
          "active": { "type": "integer", "enum": [0, 1] }
        }
      }
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "slug", "statement"],
        "properties": {
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "level_slug": { "type": "string" },
          "level_slugs": { "type": "array", "items": { "type": "string" } },
          "difficulty_slug": { "type": "string" },
          "statement": { "type": "string" },
          "is_active": { "type": "integer", "enum": [0, 1] },
          "competency_slugs": { "type": "array", "items": { "type": "string" } },
          "hints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["content"],
              "properties": {
                "order": { "type": "integer" },
                "content": { "type": "string" }
              }
            }
          },
          "solutions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["content"],
              "properties": {
                "order": { "type": "integer" },
                "title": { "type": "string" },
                "content": { "type": "string" },
                "is_official": { "type": "integer", "enum": [0, 1] }
              }
            }
          },
          "exam_meta": {
            "type": "object",
            "properties": {
              "exam_type": { "type": "string", "enum": ["written", "practical_subject"] },
              "source_type": { "type": "string" },
              "theme_bac": { "type": "string" },
              "bac_format": { "type": "string" },
              "estimated_minutes": { "type": "integer" },
              "is_exam_like": { "type": "integer", "enum": [0, 1] },
              "subject_group": { "type": "string" },
              "sort_in_subject": { "type": "integer" }
            }
          },
          "practical_calls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "prompt_html"],
              "properties": {
                "call_order": { "type": "integer" },
                "title": { "type": "string" },
                "prompt_html": { "type": "string" },
                "ai_rubric": { "type": "string" },
                "answer_mode": { "type": "string" },
                "max_points": { "type": "number" },
                "is_active": { "type": "integer", "enum": [0, 1] }
              }
            }
          },
          "practical_files": { "type": "array" }
        }
      }
    },
    "flashcards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["deck", "cards"],
        "properties": {
          "deck": {
            "type": "object",
            "required": ["title", "slug"],
            "properties": {
              "title": { "type": "string" },
              "slug": { "type": "string" },
              "description": { "type": "string" },
              "track": { "type": "string" },
              "level": { "type": "string" },
              "is_active": { "type": "integer", "enum": [0, 1] }
            }
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["front_html", "back_html"],
              "properties": {
                "card_type": { "type": "string" },
                "front_html": { "type": "string" },
                "back_html": { "type": "string" },
                "note_teacher": { "type": "string" },
                "sort_order": { "type": "integer" },
                "is_active": { "type": "integer", "enum": [0, 1] },
                "competency_slugs": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "badges": {
      "type": "array",
      "description": "Reserve pour evolution future. L'importeur 0.5.1-beta ne cree pas encore les badges depuis les packs."
    }
  }
}
